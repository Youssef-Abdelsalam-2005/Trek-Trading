[Unit]
Description=Trek Trading Execution Engine
After=docker.service
Wants=docker.service

[Service]
Type=simple
User=trek-engine
Group=trek-engine
SupplementaryGroups=trek-shared
WorkingDirectory=/opt/trek
ExecStart=/opt/trek/.venv/bin/python -m trek.engine
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
EnvironmentFile=/etc/trek/engine.env

ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/trek/logs
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
